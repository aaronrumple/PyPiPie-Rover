<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rover" Width="1440" Height="880" MinWidth="960" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12"
        Background="{DynamicResource rx.Bg}" Foreground="{DynamicResource rx.Text}"
        BorderBrush="{DynamicResource rx.Border}" BorderThickness="1">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- ===== Custom title bar caption buttons ===== -->
        <Style x:Key="rx.Caption" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource rx.Raised}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="rx.CaptionClose" TargetType="Button" BasedOn="{StaticResource rx.Caption}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Buttons ===== -->
        <Style x:Key="rx.Btn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource rx.Raised}"/>
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource rx.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource rx.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="rx.BtnPrimary" TargetType="Button" BasedOn="{StaticResource rx.Btn}">
            <Setter Property="Background" Value="{DynamicResource rx.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource rx.OnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource rx.Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Segmented source switch -->
        <Style x:Key="rx.Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource rx.Raised}" BorderBrush="{DynamicResource rx.Border}"
                                BorderThickness="1" Padding="14,5" Margin="0,0,-1,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource rx.Accent}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource rx.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource rx.OnAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scope pills -->
        <Style x:Key="rx.Pill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource rx.Border}"
                                BorderThickness="1" CornerRadius="12" Padding="12,3">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource rx.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource rx.Sel}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource rx.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource rx.SelText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Inputs ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource rx.Input}"/>
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource rx.Border}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource rx.Text}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Filter box: magnifier + hint text taken from Tag -->
        <Style x:Key="rx.FilterBox" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource rx.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{DynamicResource rx.Input}" BorderBrush="{DynamicResource rx.Border}"
                                BorderThickness="1" CornerRadius="3">
                            <Grid Margin="7,0,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Canvas Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse Width="9" Height="9" Canvas.Left="1" Canvas.Top="1" Stroke="{DynamicResource rx.Muted}" StrokeThickness="1.4"/>
                                    <Line X1="8.6" Y1="8.6" X2="12.6" Y2="12.6" Stroke="{DynamicResource rx.Muted}" StrokeThickness="1.6"/>
                                </Canvas>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Hint" Grid.Column="1" Text="{TemplateBinding Tag}" Margin="2,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource rx.Faint}" IsHitTestVisible="False" Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="PART_Clear" Grid.Column="2" Focusable="False" Cursor="Hand" ToolTip="Clear filter (Esc)"
                                        Width="20" Height="20" VerticalAlignment="Center" Content="&#xE711;"
                                        FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{DynamicResource rx.Muted}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="2">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource rx.Raised}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PART_Clear" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource rx.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource rx.Muted}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="8,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource rx.Sel}"/>
                                <Setter Property="Foreground" Value="{DynamicResource rx.SelText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{DynamicResource rx.Input}" BorderBrush="{DynamicResource rx.Border}"
                                                BorderThickness="1" CornerRadius="3">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                                                  Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource rx.Muted}" StrokeThickness="1.5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource rx.Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="8,0,26,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Margin="3,1,24,1" Padding="4,0"
                                     Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource rx.Text}" CaretBrush="{DynamicResource rx.Text}"
                                     IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource rx.Panel}" BorderBrush="{DynamicResource rx.Border}"
                                        BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="360">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Scroll bars: slider lights up whenever the pointer is anywhere on the bar ===== -->
        <Style x:Key="rx.ScrollArrow" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="rx.ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="rx.ScrollThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource rx.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="rx.VScroll" TargetType="ScrollBar">
            <Grid Background="{DynamicResource rx.Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                </Grid.RowDefinitions>
                <RepeatButton Grid.Row="0" Command="ScrollBar.LineUpCommand" Style="{StaticResource rx.ScrollArrow}">
                    <Path x:Name="ArrowA" Data="M0,4 L4,0 L8,4" Stroke="{DynamicResource rx.Faint}" StrokeThickness="1.4"/>
                </RepeatButton>
                <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource rx.ScrollPage}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb x:Name="Thumb" Style="{StaticResource rx.ScrollThumb}" Margin="3,1"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource rx.ScrollPage}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
                <RepeatButton Grid.Row="2" Command="ScrollBar.LineDownCommand" Style="{StaticResource rx.ScrollArrow}">
                    <Path x:Name="ArrowB" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource rx.Faint}" StrokeThickness="1.4"/>
                </RepeatButton>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource rx.Muted}"/>
                    <Setter TargetName="ArrowA" Property="Stroke" Value="{DynamicResource rx.Text}"/>
                    <Setter TargetName="ArrowB" Property="Stroke" Value="{DynamicResource rx.Text}"/>
                </Trigger>
                <Trigger SourceName="Thumb" Property="IsDragging" Value="True">
                    <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource rx.Accent}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Thumb" Property="Visibility" Value="Hidden"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="rx.HScroll" TargetType="ScrollBar">
            <Grid Background="{DynamicResource rx.Panel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                </Grid.ColumnDefinitions>
                <RepeatButton Grid.Column="0" Command="ScrollBar.LineLeftCommand" Style="{StaticResource rx.ScrollArrow}">
                    <Path x:Name="ArrowA" Data="M4,0 L0,4 L4,8" Stroke="{DynamicResource rx.Faint}" StrokeThickness="1.4"/>
                </RepeatButton>
                <Track x:Name="PART_Track" Grid.Column="1">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource rx.ScrollPage}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb x:Name="Thumb" Style="{StaticResource rx.ScrollThumb}" Margin="1,3"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource rx.ScrollPage}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
                <RepeatButton Grid.Column="2" Command="ScrollBar.LineRightCommand" Style="{StaticResource rx.ScrollArrow}">
                    <Path x:Name="ArrowB" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource rx.Faint}" StrokeThickness="1.4"/>
                </RepeatButton>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource rx.Muted}"/>
                    <Setter TargetName="ArrowA" Property="Stroke" Value="{DynamicResource rx.Text}"/>
                    <Setter TargetName="ArrowB" Property="Stroke" Value="{DynamicResource rx.Text}"/>
                </Trigger>
                <Trigger SourceName="Thumb" Property="IsDragging" Value="True">
                    <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource rx.Accent}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Thumb" Property="Visibility" Value="Hidden"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="MinWidth" Value="14"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Template" Value="{StaticResource rx.VScroll}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="14"/>
                    <Setter Property="MinHeight" Value="14"/>
                    <Setter Property="Template" Value="{StaticResource rx.HScroll}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Right-click menus ===== -->
        <Style x:Key="rx.Menu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource rx.Panel}" BorderBrush="{DynamicResource rx.Border}" BorderThickness="1" Padding="0,4" MinWidth="170">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="rx.MenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="14,6,24,6">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource rx.Sel}"/>
                                <Setter Property="Foreground" Value="{DynamicResource rx.SelText}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="rx.MenuSep" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="{DynamicResource rx.Border}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Tabs ===== -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource rx.Panel}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource rx.Muted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="14,8" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource rx.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Trees ===== -->
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{DynamicResource rx.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,4"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="Padding" Value="2,3"/>
        </Style>

        <!-- ===== Data grid ===== -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource rx.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="RowBackground" Value="{DynamicResource rx.Panel}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource rx.Stripe}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource rx.Hair}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource rx.Raised}"/>
            <Setter Property="Foreground" Value="{DynamicResource rx.Muted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource rx.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Opacity="0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource rx.Sel}"/>
                    <Setter Property="Foreground" Value="{DynamicResource rx.SelText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== List views (inspector) ===== -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource rx.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource rx.Raised}"/>
            <Setter Property="Foreground" Value="{DynamicResource rx.Muted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource rx.Border}"
                                    BorderThickness="0,0,1,1" Padding="8,5">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Opacity="0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource rx.Hair}"
                                BorderThickness="0,0,0,1" Padding="0,2">
                            <GridViewRowPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource rx.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource rx.Sel}"/>
                                <Setter Property="Foreground" Value="{DynamicResource rx.SelText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="rx.GroupHeader">
            <Border Background="{DynamicResource rx.Raised}" BorderBrush="{DynamicResource rx.Border}" BorderThickness="0,0,0,1" Padding="10,4">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource rx.Muted}"/>
            </Border>
        </DataTemplate>

        <!-- ===== Editable value cells (Parameters + API members) =====
             Editor column: ro | text | num | bool | id | enum  ('' / link = plain member value) -->
        <Style x:Key="rx.CellEdit" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource rx.Text}"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="2,1">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource rx.Border}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource rx.Input}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource rx.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="rx.CellEditTextNum" TargetType="TextBox" BasedOn="{StaticResource rx.CellEdit}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editor}" Value="text"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Editor}" Value="num"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="rx.CellCheck" TargetType="CheckBox">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="IsChecked" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editor}" Value="bool"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding BoolVal}" Value="1"><Setter Property="IsChecked" Value="True"/></DataTrigger>
                <DataTrigger Binding="{Binding BoolVal}" Value=""><Setter Property="IsChecked" Value="{x:Null}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="rx.CellPickPanel" TargetType="DockPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editor}" Value="id"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Editor}" Value="enum"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="rx.CellPick" TargetType="Button" BasedOn="{StaticResource rx.Btn}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="ToolTip" Value="Pick from a list"/>
        </Style>
        <Style x:Key="rx.CellChoice" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="False"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="ToolTip" Value="Pick from the list, or type a name and press Enter"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editor}" Value="id"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Editor}" Value="code"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Editor}" Value="enum"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="rx.CellReadOnly" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Foreground" Value="{DynamicResource rx.Faint}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="3,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editor}" Value="ro"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="rx.CellPlain" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="3,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editor}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Editor}" Value="link">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Foreground" Value="{DynamicResource rx.Link}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="rx.ValueCell">
            <Grid MinWidth="140">
                <TextBlock Text="{Binding Value}" Style="{StaticResource rx.CellPlain}"/>
                <TextBlock Text="{Binding Value}" Style="{StaticResource rx.CellReadOnly}"/>
                <TextBox Text="{Binding Value, Mode=OneWay}" Style="{StaticResource rx.CellEditTextNum}"/>
                <CheckBox Style="{StaticResource rx.CellCheck}"/>
                <ComboBox Text="{Binding Value, Mode=OneWay}" Style="{StaticResource rx.CellChoice}"/>
            </Grid>
        </DataTemplate>

        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource rx.Border}"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource rx.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource rx.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="10,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource rx.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource rx.Sel}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource rx.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource rx.SelText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer bar shared by the three Document panes: same fixed height keeps their scroll bars aligned.
             The list and inspector footers are empty for now, reserved for future tools. -->
        <Style x:Key="rx.PaneFooter" TargetType="Border">
            <Setter Property="DockPanel.Dock" Value="Bottom"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderBrush" Value="{DynamicResource rx.Border}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{DynamicResource rx.Panel}"/>
        </Style>
        <Style x:Key="rx.PaneHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource rx.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Title bar (drawn by Rover so the quote can sit centered) ================= -->
        <Border Grid.Row="0" Height="34" Background="{DynamicResource rx.Header}" BorderBrush="{DynamicResource rx.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image x:Name="TitleIcon" Width="20" Height="20" Margin="0,0,8,0"/>
                    <TextBlock Text="Rover" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TitleQuote" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="150,0,150,0"
                           FontStyle="Italic" FontSize="13" Foreground="{DynamicResource rx.Muted}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CapHelp" Style="{StaticResource rx.Caption}" Content="&#xE897;" ToolTip="Help (F1)"/>
                    <Button x:Name="CapMin" Style="{StaticResource rx.Caption}" Content="&#xE921;" ToolTip="Minimize"/>
                    <Button x:Name="CapMax" Style="{StaticResource rx.Caption}" Content="&#xE922;" ToolTip="Maximize"/>
                    <Button x:Name="CapClose" Style="{StaticResource rx.CaptionClose}" Content="&#xE8BB;" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Toolbar ================= -->
        <Border Grid.Row="1" Background="{DynamicResource rx.Panel}" BorderBrush="{DynamicResource rx.Border}" BorderThickness="0,0,0,1" Padding="10,9">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <RadioButton x:Name="SrcDocument" GroupName="Source" Style="{StaticResource rx.Seg}" IsChecked="True" Content="Document"/>
                    <RadioButton x:Name="SrcFamilies" GroupName="Source" Style="{StaticResource rx.Seg}" Content="Families"/>
                    <RadioButton x:Name="SrcSearch" GroupName="Source" Style="{StaticResource rx.Seg}" Content="Search"/>
                    <RadioButton x:Name="SrcWarnings" GroupName="Source" Style="{StaticResource rx.Seg}" Content="Warnings"/>
                    <RadioButton x:Name="SrcDatabase" GroupName="Source" Style="{StaticResource rx.Seg}" Content="Settings &amp; Database"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnPick" Style="{StaticResource rx.Btn}" Content="Pick in Revit" Margin="0,0,6,0" ToolTip="Pick an element in the Revit view and inspect it"/>
                    <Button x:Name="BtnIsolate" Style="{StaticResource rx.Btn}" Content="Isolate" Margin="0,0,6,0" ToolTip="Temporary isolate in the active view"/>
                    <Button x:Name="BtnZoom" Style="{StaticResource rx.Btn}" Content="Zoom to" Margin="0,0,6,0"/>
                    <Button x:Name="BtnSelect" Style="{StaticResource rx.BtnPrimary}" Content="Select in Revit" Margin="0,0,6,0"
                            ToolTip="Selects the highlighted rows, or every row in the list if none are highlighted"/>
                    <Button x:Name="BtnRefresh" Style="{StaticResource rx.Btn}" Content="Refresh"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Document / Families panel ================= -->
        <Grid x:Name="PanelDocument" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{DynamicResource rx.Border}" BorderThickness="0,0,0,1" Padding="10,7">
                <DockPanel>
                    <TextBlock x:Name="ScopeInfo" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource rx.Muted}" Margin="12,0,0,0"/>
                    <StackPanel x:Name="ScopePills" Orientation="Horizontal">
                        <TextBlock Text="SCOPE" FontWeight="SemiBold" Foreground="{DynamicResource rx.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton x:Name="ScopeDoc" GroupName="Scope" Style="{StaticResource rx.Pill}" IsChecked="True" Content="Entire document"/>
                        <RadioButton x:Name="ScopeSheet" GroupName="Scope" Style="{StaticResource rx.Pill}" Content="Active sheet"/>
                        <RadioButton x:Name="ScopeView" GroupName="Scope" Style="{StaticResource rx.Pill}" Content="Active view"/>
                        <RadioButton x:Name="ScopeSched" GroupName="Scope" Style="{StaticResource rx.Pill}" Content="Schedules"/>
                    </StackPanel>
                    <StackPanel x:Name="WarnBar" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="REVIT WARNINGS" FontWeight="SemiBold" Foreground="{DynamicResource rx.Warn}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Foreground="{DynamicResource rx.Faint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="Pick a warning or occurrence. Double-click an element to open a view showing it, fix it on the right, then Refresh."/>
                    </StackPanel>
                    <StackPanel x:Name="FamilyBar" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="FAMILIES &amp; TYPES" FontWeight="SemiBold" Foreground="{DynamicResource rx.Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Foreground="{DynamicResource rx.Faint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="All families and types - Kind shows loadable, system or internal (not in the Project Browser). Pick a type to edit or rename it; pick a family in the tree to edit the family."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" MinWidth="190"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="460" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- Tree -->
                <DockPanel Grid.Column="0" Background="{DynamicResource rx.Panel}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource rx.PaneHeader}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Group by" Foreground="{DynamicResource rx.Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="GroupBy"/>
                            </DockPanel>
                            <TextBox x:Name="TreeFilter" Style="{StaticResource rx.FilterBox}" Tag="Filter tree" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TreeFooter" Style="{StaticResource rx.PaneFooter}">
                        <CheckBox x:Name="ChkHelpers" VerticalAlignment="Center" Content="Include sketch &amp; helper elements"
                                  ToolTip="Sketch lines, automatic sketch dimensions, rail paths and uncategorized internal elements"/>
                    </Border>
                    <TreeView x:Name="Tree" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ContextMenu>
                            <ContextMenu x:Name="TreeMenu" Style="{StaticResource rx.Menu}">
                                <MenuItem x:Name="TreeExpandAll" Header="Expand All" Style="{StaticResource rx.MenuItem}"/>
                                <MenuItem x:Name="TreeCollapseAll" Header="Collapse All" Style="{StaticResource rx.MenuItem}"/>
                                <Separator Style="{StaticResource rx.MenuSep}"/>
                                <MenuItem x:Name="TreeIsolateTree" Header="Isolate" Style="{StaticResource rx.MenuItem}"
                                          ToolTip="Show only this branch in the tree"/>
                                <MenuItem x:Name="TreeShowAllTree" Header="Show All" Style="{StaticResource rx.MenuItem}"
                                          ToolTip="Show every branch in the tree again"/>
                                <Separator Style="{StaticResource rx.MenuSep}"/>
                                <MenuItem x:Name="TreeIsolate" Header="Isolate Selected in View" Style="{StaticResource rx.MenuItem}"
                                          ToolTip="Temporarily isolate this node's elements in the active Revit view"/>
                                <MenuItem x:Name="TreeShowAll" Header="Show All in View" Style="{StaticResource rx.MenuItem}"
                                          ToolTip="Reset temporary hide/isolate in the active Revit view"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </DockPanel>
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

                <!-- Element / type list -->
                <DockPanel Grid.Column="2" Background="{DynamicResource rx.Panel}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource rx.PaneHeader}" Padding="12,8">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="BtnExport" DockPanel.Dock="Right" Style="{StaticResource rx.Btn}" Content="Export CSV"/>
                                <StackPanel x:Name="FamButtons" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                                    <Button x:Name="BtnDuplicate" Style="{StaticResource rx.Btn}" Content="Duplicate type&#x2026;" Margin="0,0,6,0"/>
                                </StackPanel>
                                <TextBlock x:Name="RowCount" DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource rx.Muted}"/>
                                <TextBlock x:Name="Crumb" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBox x:Name="ListFilter" Style="{StaticResource rx.FilterBox}" Margin="0,8,0,0"
                                     Tag="Filter list: category, family, type, name, level, mark, workset or Id"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ListFooterBar" Style="{StaticResource rx.PaneFooter}">
                        <StackPanel x:Name="ListFooter" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </Border>
                    <DataGrid x:Name="ElemGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Element Id" Binding="{Binding Id}" Width="92"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130"/>
                            <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="150"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90"/>
                            <DataGridTextColumn Header="Mark" Binding="{Binding Mark}" Width="80"/>
                            <DataGridTextColumn Header="Workset" Binding="{Binding Workset}" Width="110"/>
                            <DataGridTextColumn Header="View" Binding="{Binding Context}" Width="*" MinWidth="110" Visibility="Collapsed"/>
                            <DataGridTextColumn Header="Instances" Binding="{Binding Count}" Width="80" Visibility="Collapsed"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch"/>

                <!-- Inspector / editor -->
                <DockPanel Grid.Column="4" Background="{DynamicResource rx.Panel}">
                    <Border DockPanel.Dock="Top" Style="{StaticResource rx.PaneHeader}" Padding="12,10">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="InspBack" DockPanel.Dock="Left" Style="{StaticResource rx.Btn}" Content="&#x2039;" Padding="8,0" Margin="0,0,8,0" IsEnabled="False" ToolTip="Back"/>
                                <TextBlock x:Name="InspCat" VerticalAlignment="Center" Foreground="{DynamicResource rx.Muted}" TextTrimming="CharacterEllipsis" Text="Nothing selected"/>
                            </DockPanel>
                            <TextBlock x:Name="InspTitle" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,2" TextWrapping="Wrap" Text="Select one or more rows to inspect and edit them"/>
                            <TextBox x:Name="InspIds" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap"
                                     FontFamily="Consolas" Foreground="{DynamicResource rx.Muted}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="InspSelect" Style="{StaticResource rx.BtnPrimary}" Content="Select" Margin="0,0,6,4" IsEnabled="False"/>
                                <Button x:Name="InspZoom" Style="{StaticResource rx.Btn}" Content="Zoom" Margin="0,0,6,4" IsEnabled="False"/>
                                <Button x:Name="InspOpen" Style="{StaticResource rx.Btn}" Content="Open view with element" Margin="0,0,6,4" IsEnabled="False"/>
                                <Button x:Name="InspCopy" Style="{StaticResource rx.Btn}" Content="Copy Id" Margin="0,0,6,4" IsEnabled="False"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Style="{StaticResource rx.PaneHeader}">
                        <DockPanel>
                            <CheckBox x:Name="ChkEditable" DockPanel.Dock="Right" Content="Editable only" VerticalAlignment="Center" Margin="10,0,0,0"
                                      ToolTip="Hide read-only parameters"/>
                            <TextBox x:Name="InspFilter" Style="{StaticResource rx.FilterBox}" Tag="Filter parameters, members or relations"/>
                        </DockPanel>
                    </Border>
                    <Border x:Name="InspFooterBar" Style="{StaticResource rx.PaneFooter}">
                        <StackPanel x:Name="InspFooter" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </Border>
                    <TabControl x:Name="InspTabs">
                        <TabItem x:Name="TabParams" Header="Parameters">
                            <ListView x:Name="ParamList">
                                <ListView.GroupStyle>
                                    <GroupStyle HeaderTemplate="{StaticResource rx.GroupHeader}"/>
                                </ListView.GroupStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Parameter" Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Tip}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Value (Enter to apply)" Width="190" CellTemplate="{StaticResource rx.ValueCell}"/>
                                        <GridViewColumn Header="Storage" Width="62">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Storage}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource rx.Faint}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="" Width="34">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="3" Padding="5,0" HorizontalAlignment="Center" ToolTip="{Binding Tip}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource rx.IBg}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="T">
                                                                        <Setter Property="Background" Value="{DynamicResource rx.TBg}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Kind}" FontWeight="Bold" FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource rx.IFg}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="T">
                                                                            <Setter Property="Foreground" Value="{DynamicResource rx.TFg}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </TabItem>
                        <TabItem x:Name="TabMembers" Header="API members">
                            <ListView x:Name="MemberList">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Member" Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Value" Width="180" CellTemplate="{StaticResource rx.ValueCell}"/>
                                        <GridViewColumn Header="Type" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Type}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource rx.Faint}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </TabItem>
                        <TabItem x:Name="TabRel" Header="Relations">
                            <ListView x:Name="RelList">
                                <ListView.GroupStyle>
                                    <GroupStyle HeaderTemplate="{StaticResource rx.GroupHeader}"/>
                                </ListView.GroupStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Related element (double-click)" Width="320">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource rx.Link}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Id" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource rx.Faint}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- ================= Search panel ================= -->
        <Grid x:Name="PanelSearch" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="{DynamicResource rx.Panel}">
                <Border DockPanel.Dock="Top" Style="{StaticResource rx.PaneHeader}">
                    <StackPanel>
                        <TextBlock Text="SAVED SEARCHES" FontWeight="SemiBold" Foreground="{DynamicResource rx.Muted}" Margin="2,2,0,8"/>
                        <TextBox x:Name="SavedFilter" Style="{StaticResource rx.FilterBox}" Tag="Filter saved searches"/>
                    </StackPanel>
                </Border>
                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="10,4,10,10">
                    <Button x:Name="SavImport" Style="{StaticResource rx.Btn}" Content="Import&#x2026;" Margin="0,0,3,0" ToolTip="Add searches from a JSON file"/>
                    <Button x:Name="SavExport" Style="{StaticResource rx.Btn}" Content="Export&#x2026;" Margin="3,0,0,0" ToolTip="Save all searches to a JSON file to share"/>
                </UniformGrid>
                <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="10,0">
                    <Button x:Name="SavNew" Style="{StaticResource rx.Btn}" Content="New" Margin="0,0,3,0"/>
                    <Button x:Name="SavSave" Style="{StaticResource rx.Btn}" Content="Save" Margin="3,0,3,0" ToolTip="Save under the name in the Name box"/>
                    <Button x:Name="SavDelete" Style="{StaticResource rx.Btn}" Content="Delete" Margin="3,0,0,0"/>
                </UniformGrid>
                <ListBox x:Name="SavedList"/>
            </DockPanel>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

            <DockPanel Grid.Column="2" Background="{DynamicResource rx.Panel}">
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource rx.Border}" BorderThickness="0,0,0,1" Padding="14,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button x:Name="BtnFindValue" DockPanel.Dock="Right" Style="{StaticResource rx.BtnPrimary}" Content="Find value" Margin="8,0,0,0" Padding="14,4"/>
                            <TextBlock DockPanel.Dock="Left" Text="Find value anywhere" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBox x:Name="FindValueBox" Height="30" FontSize="13"
                                     ToolTip="Searches every instance and type parameter value in the scope below. Press Enter."/>
                        </DockPanel>
                        <WrapPanel>
                            <TextBlock Text="Name" VerticalAlignment="Center" Foreground="{DynamicResource rx.Muted}" Margin="0,0,6,0"/>
                            <TextBox x:Name="SearchName" Width="230" Height="26" Margin="0,0,14,6"/>
                            <TextBlock Text="Match" VerticalAlignment="Center" Foreground="{DynamicResource rx.Muted}" Margin="0,0,6,0"/>
                            <ComboBox x:Name="MatchMode" Width="170" Margin="0,0,14,6"/>
                            <TextBlock Text="Scope" VerticalAlignment="Center" Foreground="{DynamicResource rx.Muted}" Margin="0,0,6,0"/>
                            <ComboBox x:Name="SearchScope" Width="230" Margin="0,0,14,6"/>
                            <CheckBox x:Name="ChkTypes" Content="Include element types" VerticalAlignment="Center" Margin="0,0,14,6"/>
                            <CheckBox x:Name="ChkCase" Content="Case sensitive" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <StackPanel x:Name="CondPanel" Margin="0,8,0,0"/>
                        <DockPanel Margin="0,4,0,0">
                            <Button x:Name="BtnRunSearch" DockPanel.Dock="Right" Style="{StaticResource rx.BtnPrimary}" Content="Run search" Padding="18,4"/>
                            <Button x:Name="BtnAddCond" DockPanel.Dock="Left" Style="{StaticResource rx.Btn}" Content="+ Condition"/>
                            <TextBlock Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource rx.Faint}" TextTrimming="CharacterEllipsis"
                                       Text="Numbers use project units (12', 3' 6&quot;, 0). Open a list for names and values found in the model."/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Top" Style="{StaticResource rx.PaneHeader}" Padding="14,8">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="ResExport" Style="{StaticResource rx.Btn}" Content="Export CSV" Margin="0,0,6,0"/>
                                <Button x:Name="ResToDoc" Style="{StaticResource rx.Btn}" Content="Open in Document tab" Margin="0,0,6,0"
                                        ToolTip="Browse and edit the results with the tree and the inspector"/>
                                <Button x:Name="ResIsolate" Style="{StaticResource rx.Btn}" Content="Isolate" Margin="0,0,6,0"/>
                                <Button x:Name="ResAddSel" Style="{StaticResource rx.Btn}" Content="Add to selection" Margin="0,0,6,0"/>
                                <Button x:Name="ResSelect" Style="{StaticResource rx.BtnPrimary}" Content="Select in Revit"/>
                            </StackPanel>
                            <TextBlock x:Name="ResultCount" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="Run a search or find a value"/>
                        </DockPanel>
                        <TextBox x:Name="ResFilter" Style="{StaticResource rx.FilterBox}" Tag="Filter results" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <DataGrid x:Name="ResGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Element Id" Binding="{Binding Id}" Width="92"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130"/>
                        <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="150"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90"/>
                        <DataGridTextColumn Header="Matched on" Binding="{Binding Context}" Width="*" MinWidth="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <!-- ================= Settings & database panel ================= -->
        <Grid x:Name="PanelDatabase" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Background="{DynamicResource rx.Panel}">
                <Border DockPanel.Dock="Top" Style="{StaticResource rx.PaneHeader}">
                    <TextBox x:Name="DbTreeFilter" Style="{StaticResource rx.FilterBox}" Tag="Filter settings &amp; database"/>
                </Border>
                <TreeView x:Name="DbTree">
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="DbTreeMenu" Style="{StaticResource rx.Menu}">
                            <MenuItem x:Name="DbExpandAll" Header="Expand All" Style="{StaticResource rx.MenuItem}"/>
                            <MenuItem x:Name="DbCollapseAll" Header="Collapse All" Style="{StaticResource rx.MenuItem}"/>
                            <Separator Style="{StaticResource rx.MenuSep}"/>
                            <MenuItem x:Name="DbIsolateTree" Header="Isolate" Style="{StaticResource rx.MenuItem}"
                                      ToolTip="Show only this branch in the tree"/>
                            <MenuItem x:Name="DbShowAllTree" Header="Show All" Style="{StaticResource rx.MenuItem}"
                                      ToolTip="Show every branch in the tree again"/>
                            <Separator Style="{StaticResource rx.MenuSep}"/>
                            <MenuItem x:Name="DbIsolate" Header="Isolate Selected in View" Style="{StaticResource rx.MenuItem}" IsEnabled="False"/>
                            <MenuItem x:Name="DbShowAll" Header="Show All in View" Style="{StaticResource rx.MenuItem}" IsEnabled="False"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </DockPanel>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
            <DockPanel Grid.Column="2" Background="{DynamicResource rx.Panel}">
                <Border DockPanel.Dock="Top" Style="{StaticResource rx.PaneHeader}" Padding="14,10">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="DbBack" DockPanel.Dock="Left" Style="{StaticResource rx.Btn}" Content="&#x2039;" Padding="8,0" Margin="0,0,8,0" IsEnabled="False" ToolTip="Back"/>
                            <TextBlock x:Name="DbTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="Pick an item on the left"/>
                        </DockPanel>
                        <TextBlock x:Name="DbClass" Margin="0,4,0,8" FontFamily="Consolas" Foreground="{DynamicResource rx.Muted}"/>
                        <TextBox x:Name="DbFilter" Style="{StaticResource rx.FilterBox}" Tag="Filter members"/>
                    </StackPanel>
                </Border>
                <ListView x:Name="DbMembers">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Member" Width="280">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Value" Width="460" CellTemplate="{StaticResource rx.ValueCell}"/>
                            <GridViewColumn Header="Type" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Type}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource rx.Faint}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="3" Background="{DynamicResource rx.Header}" BorderBrush="{DynamicResource rx.Border}" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="ThemeLabel" DockPanel.Dock="Right" Foreground="{DynamicResource rx.Muted}"/>
                <TextBlock x:Name="Status" Foreground="{DynamicResource rx.Muted}" TextTrimming="CharacterEllipsis"
                           Text="Edit a value and press Enter. Double-click a row to open a view showing it."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
